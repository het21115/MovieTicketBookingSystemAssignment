@model IEnumerable<MovieTicketBookingSystem.Models.Movie>

@{
    ViewBag.Title = "Search Movie";
}

<h2>Search Movie By Category</h2>

@using (Html.BeginForm("SearchMovie", "Movie", FormMethod.Post))
{
    <label>Select Category</label>

    @Html.DropDownList(
        "categoryId",
        (SelectList)ViewBag.CategoryList,
        "-- Select Category --"
    )

    <input type="submit" value="Search" />
}

<br />

@if (Model != null)
{
    <h3>Movies</h3>

    <table border="1" cellpadding="10">
        <tr>
            <th>Movie ID</th>
            <th>Movie Name</th>
            <th>Release Date</th>
            <th>Category ID</th>
            <th>Rate</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Movie_id</td>
                <td>@item.Movie_name</td>
                <td>@item.Release_date.ToShortDateString()</td>
                <td>@item.Category_id</td>
                <td>@item.Rate</td>
            </tr>
        }
    </table>
}