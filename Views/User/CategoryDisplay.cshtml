@model IEnumerable<MovieTicketBookingSystem.Models.MovieCategory>

@{
    ViewBag.Title = "Movie Categories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Movie Categories</h2>

<p>
    @Html.ActionLink(
        "Create New Category",
        "CreateCategory",
        "User",
        null,
        new { @class = "btn btn-primary" }
    )
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Category ID</th>
            <th>Type</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Category_id</td>
                <td>@category.Type</td>
                <td>
                    @Html.ActionLink(
                        "Edit",
                        "Edit",
                        new { id = category.Category_id }
                    )
                    |
                    @Html.ActionLink(
                        "Delete",
                        "Delete",
                        new { id = category.Category_id }
                    )
                </td>
            </tr>
        }
    </tbody>

</table>